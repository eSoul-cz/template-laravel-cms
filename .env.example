APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The dev stack (docker-compose.yml) serves the application on APP_PORT; `artisan serve` on the host is not supported.
APP_PORT=8080
APP_URL=http://localhost:${APP_PORT}

# Addresses or CIDR ranges of the reverse proxies whose forwarded headers (scheme, host, client address) are trusted,
# separated by commas, e.g. 172.18.0.0/16. Empty trusts none, which is right behind the host NGINX: it passes the scheme
# and the client address to php-fpm as FastCGI parameters. Never `*`.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail goes to Mailpit (docker-compose.yml): SMTP on MAIL_PORT, inbox UI on http://localhost:${MAILPIT_UI_PORT}.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenTelemetry: every deployed application exports traces, logs and metrics over OTLP (gRPC) to the host collector.
# The `opentelemetry` PHP extension is in the base image; the SDK and the Laravel auto-instrumentation are added by the
# project that turns it on (README, "OpenTelemetry"). Until then OTEL_PHP_AUTOLOAD_ENABLED stays false and nothing is exported.
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_SERVICE_NAME=replace-with-app-name
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local

# Money (App\Domain\ValueObjects\Money): the currency of a row that has none, and of a column cast with `MoneyCast::class . ':config'`.
MONEY_DEFAULT_CURRENCY=CZK
# Production image (docker/production): what the entrypoint starts. Each switch is exactly `true` or `false`.
RUN_MIGRATIONS=true
RUN_SCHEDULER=true
RUN_QUEUE_WORKER=true

# Development docker-compose.yml. WWWUSER/WWWGROUP: `id -u` and `id -g` on Linux, ignored on Docker Desktop / OrbStack.
# The compose services connect to the `mariadb` service (DB_* are overridden there); the plain .env keeps SQLite.
WWWUSER=1000
WWWGROUP=1000
VITE_PORT=5173
FORWARD_DB_PORT=3306
DB_ROOT_PASSWORD=secret
MAILPIT_UI_PORT=8025

# --- CMS (headless: the Astro frontend in ../frontend builds from GET /cms-api/v1/export) ---
# Bearer token of the export, read by the frontend build (= CMS_API_TOKEN there). Empty = export disabled (404).
CMS_EXPORT_TOKEN=
# IPs / CIDRs (comma separated) allowed to call /cms-api (build agent and Jenkins callback). Empty = no restriction.
CMS_API_ALLOWED_IPS=
# Directory of the public media copy that the web server serves at /_cms/. Empty = storage/app/cms-public.
CMS_PUBLIC_MEDIA_ROOT=

# Publish button -> Jenkins job `buildWithParameters` (parameter CMS_PUBLISH_ID).
CMS_JENKINS_JOB_URL=
CMS_JENKINS_USER=
CMS_JENKINS_API_TOKEN=
# Bearer token Jenkins uses to report the result to POST /cms-api/v1/publishes/{id}/status.
CMS_JENKINS_CALLBACK_TOKEN=
# A publish without a result after this many minutes is marked failed (the callback is best effort).
CMS_PUBLISH_TIMEOUT=30

# --- Forms (POST /forms/contact, called by the browsers of the visitors of the static site; docs/forms.md) ---
# Sites (origins, comma separated) that may post to the form endpoint, e.g. https://example.com. The Origin header must be
# listed, otherwise 403. Empty = every post is rejected in production (any origin is accepted only when APP_ENV=local).
CMS_FORMS_ALLOWED_ORIGINS=
# E-mail recipients of the submissions (comma separated). Empty = the contact e-mail of the site settings.
# SMTP is the normal MAIL_* settings above. Nginx must route `location /forms` to this backend (docs/forms.md).
CMS_FORMS_RECIPIENTS=
# reCAPTCHA v3 secret key (registered for the production domain). Empty is allowed outside production only: the check
# is skipped with a logged warning; in production the endpoint answers 503 without it.
CMS_FORMS_RECAPTCHA_SECRET=
# Submissions scoring below this are rejected (0.0 to 1.0).
CMS_FORMS_RECAPTCHA_MIN_SCORE=0.5

# --- Where the backend lives (README of the astro-cms template, "Where the backend lives") ---
# Default, RECOMMENDED: the backend on a subdomain (admin.example.com): APP_URL=https://admin.example.com, SESSION_DOMAIN=null
# (host-only cookie, never .example.com), SESSION_PATH=/ and CMS_ADMIN_PATH_MODE=false.
# Exception, one hostname only: the backend under /admin of the site's domain: APP_URL=https://example.com, SESSION_DOMAIN=null,
# SESSION_PATH=/admin (the cookie never reaches the public site) and CMS_ADMIN_PATH_MODE=true, which moves Livewire's update
# endpoint under /admin/livewire/ where that cookie is sent.
CMS_ADMIN_PATH_MODE=false
